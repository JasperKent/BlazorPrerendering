{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": "https+http://blazorprerendering-api",
  "ReverseProxy": {
    "Routes": {
      "apiRoute": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/api/{*any}"
        }
      },
      "swaggerRoute": {
        "ClusterId": "apiCluster",
        "Match": {
          "Path": "/swagger/{*any}"
        }
      }
    },
    "Clusters": {
      "apiCluster": {
        "Destinations": {
          "apiDestination": {
            "Address": "https+http://blazorprerendering-api"
          }
        }
      }
    }
  }
}
