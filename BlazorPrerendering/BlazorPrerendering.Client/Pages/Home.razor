@page "/"
@using BlazorPrerendering.Data.Models
@using BlazorPrerendering.Client.Services
@implements IDisposable
@inject IApiService ApiService
@inject IPersistenceService Persistor

<PageTitle>Home</PageTitle>

@if (_books is null || _authors is null)
{
    <p>Loading ...</p>
}
else
{
    <h1>Here are some books and authors:</h1>
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Year</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in _books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Year</td>
                    <td><button disabled="@(!_enabled)" @onclick="()=>ShowDetails(book)">Details</button></td>
                </tr>
            }
        </tbody>
    </table>

    <table>
        <thead>
            <tr>
                <th>First Name</th>
                <th>Last Name</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var author in _authors)
            {
                <tr>
                    <td>@author.FirstName</td>
                    <td>@author.LastName</td>
                </tr>
            }
        </tbody>
    </table>
}

@if(_detail is not null)
{
    <fieldset>
        <legend>
            @_detail.Title
        </legend>
        <section>
            This book was published in @_detail.Year
        </section>
    </fieldset>
}

@code{
    private IEnumerable<Book>? _books = null;
    private IEnumerable<Author>? _authors = null;
    private Book? _detail = null;
    private PersistingComponentStateSubscription? _subscription;
    private bool _enabled;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _subscription = await Persistor
                 .Register(books => _books = books, 
                           () => ApiService.GetBooks())
                 .Register(authors => _authors = authors, 
                           () => ApiService.GetAuthors())
                 .Build();

        if(OperatingSystem.IsBrowser())
            _enabled = true;
    }

    private void ShowDetails(Book book)
    {
        _detail = book;
    }

    public void Dispose()
    {
        _subscription?.Dispose();
    }
}
