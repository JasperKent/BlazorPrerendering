@page "/"
@using BlazorPrerendering.Client.Models
@implements IDisposable
@inject HttpClient HttpClient
@inject PersistentComponentState ComponentState

<PageTitle>Home</PageTitle>

@if (_books is null)
{
    <p>Loading ...</p>
}
else
{
    <h1>Here are some books:</h1>
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Year</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in _books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Year</td>
                    <td><button disabled="@(!_enabled)" @onclick="()=>ShowDetails(book)">Details</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@if(_detail is not null)
{
    <fieldset>
        <legend>
            @_detail.Title
        </legend>
        <section>
            This book was published in @_detail.Year
        </section>
    </fieldset>
}

@code{
    private IEnumerable<Book>? _books = null;
    private Book? _detail = null;
    private PersistingComponentStateSubscription? _subscription;
    private bool _enabled;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _subscription = ComponentState.RegisterOnPersisting(PersistData);

        if (ComponentState.TryTakeFromJson<IEnumerable<Book>>("books", out var books))
            _books = books;
        else
            _books = await HttpClient.GetFromJsonAsync<IEnumerable<Book>>("/api/books");

        if(OperatingSystem.IsBrowser())
            _enabled = true;
    }

    private Task PersistData()
    {
        ComponentState.PersistAsJson("books", _books);

        return Task.CompletedTask;
    }

    private void ShowDetails(Book book)
    {
        _detail = book;
    }

    public void Dispose()
    {
        _subscription?.Dispose();
    }
}
